<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,380;9..144,500;9..144,600&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />

<style>
/* ============================================
   TOKENS
   Paper: warm off-white surface, ink-navy text.
   Accent: a single signal-blue, used sparingly —
   the color of a status light on hardware, not a
   gradient. Grounded in "build artifact" language:
   blueprint grid, build log, module manifest.
   ============================================ */
:root{
  --paper:      #f6f4ef;
  --paper-dim:  #efece3;
  --ink:        #171712;
  --ink-soft:   #57584f;
  --ink-faint:  #94958a;
  --line:       #dcd8cb;
  --line-soft:  #e8e5d9;
  --signal:     #1f4fff;
  --signal-dim: #e5eafe;
  --live:       #1c7a4d;
  --live-bg:    #e4f2ea;
  --test:       #9a6a12;
  --test-bg:    #f6ecd8;

  --display: 'Fraunces', serif;
  --body:    'Inter', sans-serif;
  --mono:    'IBM Plex Mono', monospace;

  --wrap: 1120px;
}

*,*::before,*::after{ box-sizing:border-box; margin:0; padding:0; }

html{ scroll-behavior:smooth; }

body{
  background:var(--paper);
  color:var(--ink);
  font-family:var(--body);
  font-size:16px;
  line-height:1.5;
  -webkit-font-smoothing:antialiased;
}

body.modal-open{ overflow:hidden; }

/* faint blueprint grid, fixed, very low contrast */
body::before{
  content:'';
  position:fixed;
  inset:0;
  z-index:0;
  pointer-events:none;
  background-image:
    linear-gradient(var(--line-soft) 1px, transparent 1px),
    linear-gradient(90deg, var(--line-soft) 1px, transparent 1px);
  background-size: 64px 64px;
  opacity:.5;
  mask-image: linear-gradient(to bottom, black, transparent 85%);
}

a{ color:inherit; }

img{ max-width:100%; display:block; }

.wrap{
  max-width:var(--wrap);
  margin:0 auto;
  padding-left:56px;
  padding-right:56px;
  position:relative;
  z-index:1;
}

::selection{ background:var(--signal); color:#fff; }

:focus-visible{
  outline:2px solid var(--signal);
  outline-offset:3px;
}

/* ============================================
   NAV
   ============================================ */
header{
  position:sticky;
  top:0;
  z-index:50;
  background:rgba(246,244,239,.88);
  backdrop-filter:blur(10px);
  border-bottom:1px solid var(--line);
}

nav.wrap{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding-top:20px;
  padding-bottom:20px;
}

.brand{
  font-family:var(--mono);
  font-size:14px;
  font-weight:500;
  letter-spacing:.02em;
}

.brand span{ color:var(--signal); }

.nav-links{
  display:flex;
  align-items:center;
  gap:36px;
}

.nav-links a{
  font-family:var(--mono);
  font-size:13px;
  text-decoration:none;
  color:var(--ink-soft);
  letter-spacing:.02em;
  transition:color .15s;
}

.nav-links a:hover{ color:var(--ink); }

.avail{
  display:flex;
  align-items:center;
  gap:8px;
  font-family:var(--mono);
  font-size:12px;
  color:var(--ink-soft);
  padding:6px 14px;
  border:1px solid var(--line);
  border-radius:100px;
  white-space:nowrap;
}

.avail-dot{
  width:6px; height:6px;
  border-radius:50%;
  background:var(--live);
  flex-shrink:0;
}

@media (max-width:860px){
  .nav-links{ display:none; }
}

/* ============================================
   HERO
   ============================================ */
.hero{
  padding-top:96px;
  padding-bottom:88px;
  display:grid;
  grid-template-columns:1.35fr 1fr;
  gap:64px;
  align-items:end;
}

.eyebrow{
  font-family:var(--mono);
  font-size:12px;
  color:var(--signal);
  letter-spacing:.06em;
  display:flex;
  align-items:center;
  gap:12px;
  margin-bottom:28px;
}

.eyebrow::before{
  content:'';
  width:28px; height:1px;
  background:var(--signal);
}

h1.name{
  font-family:var(--display);
  font-weight:600;
  font-size:clamp(44px,6.4vw,84px);
  line-height:.98;
  letter-spacing:-.01em;
  margin-bottom:26px;
}

h1.name em{
  font-style:italic;
  font-weight:380;
  color:var(--signal);
}

.hero-lede{
  font-size:18px;
  color:var(--ink-soft);
  max-width:52ch;
  line-height:1.6;
  margin-bottom:36px;
}

.hero-lede strong{ color:var(--ink); font-weight:600; }

.hero-cta{
  display:flex;
  gap:14px;
  flex-wrap:wrap;
}

.btn{
  font-family:var(--mono);
  font-size:13px;
  letter-spacing:.02em;
  padding:13px 24px;
  border-radius:4px;
  text-decoration:none;
  display:inline-flex;
  align-items:center;
  gap:8px;
  transition:transform .15s, background .15s, border-color .15s;
  border:none;
  cursor:pointer;
}

.btn-solid{
  background:var(--ink);
  color:var(--paper);
  border:1px solid var(--ink);
}
.btn-solid:hover{ background:var(--signal); border-color:var(--signal); transform:translateY(-2px); }

.btn-line{
  background:transparent;
  color:var(--ink);
  border:1px solid var(--line);
}
.btn-line:hover{ border-color:var(--ink); transform:translateY(-2px); }

/* hero side: a manifest, not a stat-brag */
.manifest{
  border:1px solid var(--line);
  border-radius:8px;
  background:#fff;
  overflow:hidden;
}

.manifest-head{
  font-family:var(--mono);
  font-size:11px;
  color:var(--ink-faint);
  letter-spacing:.06em;
  padding:14px 20px;
  border-bottom:1px solid var(--line);
  background:var(--paper-dim);
}

.manifest-row{
  display:flex;
  justify-content:space-between;
  gap:16px;
  padding:16px 20px;
  border-bottom:1px solid var(--line-soft);
  font-family:var(--mono);
  font-size:13px;
}

.manifest-row:last-child{ border-bottom:none; }

.manifest-k{ color:var(--ink-faint); }
.manifest-v{ color:var(--ink); text-align:right; }

@media (max-width:860px){
  .hero{ grid-template-columns:1fr; padding-top:56px; padding-bottom:56px; gap:40px; }
}

/* ============================================
   SECTION SCAFFOLD
   ============================================ */
section{ padding:76px 0; }

.section-head{
  display:flex;
  align-items:baseline;
  justify-content:space-between;
  gap:24px;
  margin-bottom:44px;
  flex-wrap:wrap;
}

.tag{
  font-family:var(--mono);
  font-size:12px;
  color:var(--signal);
  letter-spacing:.06em;
  display:flex;
  align-items:center;
  gap:10px;
}

.tag::before{ content:'§'; color:var(--ink-faint); }

h2.stitle{
  font-family:var(--display);
  font-weight:600;
  font-size:clamp(28px,3.6vw,44px);
  letter-spacing:-.01em;
  line-height:1.05;
}

h2.stitle em{ font-style:italic; font-weight:380; color:var(--signal); }

.section-note{
  font-family:var(--mono);
  font-size:12px;
  color:var(--ink-faint);
  text-align:right;
}

hr.rule{
  border:none;
  border-top:1px solid var(--line);
  margin:0 0 76px;
}

/* ============================================
   ABOUT
   ============================================ */
.about-grid{
  display:grid;
  grid-template-columns:0.9fr 1.1fr;
  gap:64px;
}

.about-copy{
  font-size:17px;
  color:var(--ink-soft);
  line-height:1.75;
  max-width:60ch;
}

.about-copy p{ margin-bottom:18px; }
.about-copy p:last-child{ margin-bottom:0; }
.about-copy strong{ color:var(--ink); font-weight:600; }

.credentials{
  display:flex;
  flex-direction:column;
  gap:0;
  border-top:1px solid var(--line);
}

.cred-row{
  display:flex;
  justify-content:space-between;
  gap:20px;
  padding:18px 0;
  border-bottom:1px solid var(--line);
}

.cred-k{
  font-family:var(--mono);
  font-size:11px;
  color:var(--ink-faint);
  letter-spacing:.06em;
  text-transform:uppercase;
  padding-top:2px;
  flex-shrink:0;
  width:120px;
}

.cred-v{
  font-size:15px;
  color:var(--ink);
  text-align:right;
}

.cred-v span{
  display:block;
  font-size:13px;
  color:var(--ink-soft);
  margin-top:2px;
}

@media (max-width:860px){
  .about-grid{ grid-template-columns:1fr; gap:40px; }
}

/* ============================================
   STACK — grouped by role, not a flat grid.
   ============================================ */
.stack-groups{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:1px;
  background:var(--line);
  border:1px solid var(--line);
  border-radius:8px;
  overflow:hidden;
}

.stack-group{
  background:#fff;
  padding:28px 26px;
}

.stack-group-title{
  font-family:var(--mono);
  font-size:11px;
  color:var(--signal);
  letter-spacing:.06em;
  text-transform:uppercase;
  margin-bottom:18px;
  padding-bottom:14px;
  border-bottom:1px solid var(--line-soft);
}

.stack-item{
  display:flex;
  justify-content:space-between;
  align-items:baseline;
  gap:12px;
  padding:9px 0;
  font-size:14.5px;
}

.stack-item + .stack-item{ border-top:1px solid var(--line-soft); }

.stack-item-name{ color:var(--ink); font-weight:500; }
.stack-item-note{
  font-family:var(--mono);
  font-size:11.5px;
  color:var(--ink-faint);
  text-align:right;
  white-space:nowrap;
}

@media (max-width:860px){
  .stack-groups{ grid-template-columns:1fr; }
}

/* ============================================
   PUBLISHED WORK — one platform, two deployments
   ============================================ */
.platform-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:22px;
}

.platform-card{
  background:#fff;
  border:1px solid var(--line);
  border-radius:14px;
  overflow:hidden;
  display:flex;
  flex-direction:column;
  transition:border-color .18s, box-shadow .18s;
  cursor:pointer;
}

.platform-card:hover{
  border-color:var(--ink);
  box-shadow:0 14px 32px -18px rgba(23,23,18,.28);
}

.platform-top{
  display:flex;
  gap:16px;
  padding:22px 24px 18px;
  border-bottom:1px solid var(--line-soft);
}

.platform-media{
  width:64px; height:64px;
  border-radius:10px;
  overflow:hidden;
  flex-shrink:0;
  border:1px solid var(--line);
  background:var(--paper-dim);
  position:relative;
}

.platform-media img{
  width:100%; height:100%;
  object-fit:cover;
  transition:opacity .18s ease;
}

.platform-heading{ flex:1; min-width:0; padding-top:2px; }

.platform-label{
  font-family:var(--mono);
  font-size:10.5px;
  letter-spacing:.06em;
  text-transform:uppercase;
  color:var(--signal);
  margin-bottom:4px;
}

.platform-name{
  font-family:var(--display);
  font-weight:600;
  font-size:19px;
  letter-spacing:-.005em;
  transition:opacity .12s ease;
}

.platform-status{
  display:inline-flex;
  align-items:center;
  gap:5px;
  font-family:var(--mono);
  font-size:10px;
  letter-spacing:.04em;
  text-transform:uppercase;
  color:var(--live);
  margin-top:5px;
}

.platform-status::before{ content:''; width:5px; height:5px; border-radius:50%; background:var(--live); }

.platform-body{
  padding:18px 24px 22px;
  flex:1;
  display:flex;
  flex-direction:column;
}

.platform-desc{
  font-size:13.5px;
  color:var(--ink-soft);
  line-height:1.65;
  margin-bottom:16px;
}

.platform-desc strong{ color:var(--ink); font-weight:600; }

.platform-features{
  display:flex;
  flex-wrap:wrap;
  gap:7px;
  margin-bottom:20px;
}

.platform-feature{
  font-family:var(--mono);
  font-size:10.5px;
  color:var(--ink-soft);
  background:var(--paper-dim);
  border:1px solid var(--line-soft);
  padding:4px 10px;
  border-radius:100px;
}

/* variant switch: the ONE thing that actually differs */
.variant-row{
  margin-top:auto;
}

.variant-label{
  font-family:var(--mono);
  font-size:10px;
  letter-spacing:.06em;
  text-transform:uppercase;
  color:var(--ink-faint);
  margin-bottom:8px;
}

.variant-switch{
  display:flex;
  border:1px solid var(--line);
  border-radius:8px;
  overflow:hidden;
  margin-bottom:14px;
}

.variant-btn{
  flex:1;
  background:#fff;
  border:none;
  font-family:var(--mono);
  font-size:12px;
  letter-spacing:.02em;
  color:var(--ink-soft);
  padding:10px 8px;
  cursor:pointer;
  transition:background .15s, color .15s;
  position:relative;
}

.variant-btn + .variant-btn{ border-left:1px solid var(--line); }

.variant-btn:hover{ background:var(--paper-dim); }

.variant-btn.active{
  background:var(--ink);
  color:var(--paper);
}

.variant-actions{
  display:flex;
  gap:10px;
}

.platform-store-btn{
  flex:1;
  font-family:var(--mono);
  font-size:12px;
  letter-spacing:.02em;
  color:#fff;
  background:var(--ink);
  border:1px solid var(--ink);
  border-radius:6px;
  padding:11px 14px;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:6px;
  text-decoration:none;
  transition:background .15s, border-color .15s, transform .15s;
}

.platform-store-btn:hover{ background:var(--signal); border-color:var(--signal); transform:translateY(-2px); }

.platform-shared-note{
  grid-column:1 / -1;
  font-family:var(--mono);
  font-size:11.5px;
  color:var(--ink-faint);
  display:flex;
  align-items:center;
  gap:10px;
  margin-top:2px;
}

.platform-shared-note::before{
  content:'';
  width:20px; height:1px;
  background:var(--line);
  flex-shrink:0;
}

.apps-lead{
  font-size:14.5px;
  color:var(--ink-soft);
  max-width:64ch;
  line-height:1.65;
}

.apps-lead strong{ color:var(--ink); font-weight:600; }

@media (max-width:760px){
  .platform-grid{ grid-template-columns:1fr; }
}

/* ---- Detail modal ---- */
.detail-overlay{
  position:fixed;
  inset:0;
  z-index:100;
  background:rgba(23,23,18,.46);
  backdrop-filter:blur(3px);
  display:flex;
  align-items:center;
  justify-content:center;
  padding:24px;
  opacity:0;
  pointer-events:none;
  transition:opacity .22s ease;
}

.detail-overlay.open{
  opacity:1;
  pointer-events:auto;
}

.detail-panel{
  position:relative;
  background:var(--paper);
  border:1px solid var(--line);
  border-radius:14px;
  max-width:640px;
  width:100%;
  max-height:88vh;
  overflow-y:auto;
  transform:translateY(18px) scale(.98);
  transition:transform .24s cubic-bezier(.2,.8,.2,1);
  box-shadow:0 30px 60px -20px rgba(23,23,18,.35);
}

.detail-overlay.open .detail-panel{ transform:translateY(0) scale(1); }

.detail-top{
  display:flex;
  gap:20px;
  padding:28px 28px 20px;
  border-bottom:1px solid var(--line);
}

.detail-media{
  width:96px; height:96px;
  border-radius:12px;
  overflow:hidden;
  border:1px solid var(--line);
  flex-shrink:0;
  background:var(--paper-dim);
}

.detail-media img{ width:100%; height:100%; object-fit:cover; }

.detail-heading{ flex:1; min-width:0; }

.detail-title{
  font-family:var(--display);
  font-weight:600;
  font-size:26px;
  letter-spacing:-.01em;
  margin-bottom:8px;
}

.detail-badges{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
}

.detail-badge{
  font-family:var(--mono);
  font-size:10.5px;
  letter-spacing:.04em;
  text-transform:uppercase;
  padding:4px 10px;
  border-radius:100px;
  background:var(--paper-dim);
  color:var(--ink-soft);
  border:1px solid var(--line);
}

.detail-badge.b-live{ background:var(--live-bg); color:var(--live); border-color:rgba(28,122,77,.25); }

.detail-close{
  position:absolute;
  top:18px; right:18px;
  width:32px; height:32px;
  border-radius:50%;
  border:1px solid var(--line);
  background:#fff;
  color:var(--ink-soft);
  font-size:16px;
  line-height:1;
  display:flex;
  align-items:center;
  justify-content:center;
  cursor:pointer;
  transition:border-color .15s, color .15s, transform .15s;
}

.detail-close:hover{ border-color:var(--ink); color:var(--ink); transform:rotate(90deg); }

.detail-body{
  padding:24px 28px 28px;
}

.detail-desc{
  font-size:15px;
  color:var(--ink-soft);
  line-height:1.7;
  margin-bottom:22px;
}

.detail-features{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
  margin-bottom:26px;
}

.detail-feature{
  font-size:13.5px;
  color:var(--ink);
  padding:11px 14px;
  background:#fff;
  border:1px solid var(--line);
  border-radius:8px;
  display:flex;
  align-items:baseline;
  gap:8px;
}

.detail-feature::before{
  content:'—';
  color:var(--signal);
  flex-shrink:0;
}

.detail-meta-row{
  display:flex;
  justify-content:space-between;
  align-items:center;
  font-family:var(--mono);
  font-size:12px;
  color:var(--ink-faint);
  padding:14px 0;
  border-top:1px solid var(--line-soft);
  margin-bottom:22px;
}

.detail-actions{
  display:flex;
  gap:12px;
  flex-wrap:wrap;
}

@media (max-width:560px){
  .detail-top{ flex-direction:column; align-items:flex-start; padding:24px 20px 18px; }
  .detail-body{ padding:20px 20px 24px; }
  .detail-features{ grid-template-columns:1fr; }
  .detail-close{ top:14px; right:14px; }
}

/* ============================================
   OPEN SOURCE — dense manifest list
   ============================================ */
.oss-list{
  border:1px solid var(--line);
  border-radius:8px;
  overflow:hidden;
  background:#fff;
}

.oss-row{
  display:flex;
  align-items:center;
  gap:22px;
  padding:20px 28px;
  text-decoration:none;
  border-bottom:1px solid var(--line-soft);
  transition:background .15s;
}

.oss-row:last-child{ border-bottom:none; }
.oss-row:hover{ background:var(--paper-dim); }

.oss-idx{
  font-family:var(--mono);
  font-size:11px;
  color:var(--ink-faint);
  width:22px;
  flex-shrink:0;
}

.oss-main{ flex:1; min-width:0; }

.oss-name{
  font-size:15px;
  font-weight:600;
  color:var(--ink);
}

.oss-desc{
  font-size:13px;
  color:var(--ink-soft);
  margin-top:2px;
}

.oss-tags{
  display:flex;
  gap:8px;
  flex-shrink:0;
}

.oss-tag{
  font-family:var(--mono);
  font-size:10.5px;
  color:var(--signal);
  background:var(--signal-dim);
  padding:3px 10px;
  border-radius:100px;
  white-space:nowrap;
}

.oss-arr{
  color:var(--ink-faint);
  font-size:15px;
  flex-shrink:0;
  transition:color .15s, transform .15s;
}

.oss-row:hover .oss-arr{ color:var(--signal); transform:translate(2px,-2px); }

@media (max-width:640px){
  .oss-row{ flex-wrap:wrap; padding:18px 20px; }
  .oss-tags{ width:100%; padding-left:44px; }
}

/* ============================================
   CONTACT
   ============================================ */
.contact-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:1px;
  background:var(--line);
  border:1px solid var(--line);
  border-radius:8px;
  overflow:hidden;
}

.c-card{
  background:#fff;
  padding:28px 22px;
  text-decoration:none;
  display:flex;
  flex-direction:column;
  gap:16px;
  transition:background .15s;
}

.c-card:hover{ background:var(--paper-dim); }

.c-ico{
  width:38px;height:38px;
  border-radius:8px;
  display:flex;align-items:center;justify-content:center;
  font-size:17px;
  border:1px solid var(--line);
  background:var(--paper-dim);
}

.c-name{
  font-size:14.5px;
  font-weight:600;
  color:var(--ink);
  display:flex;
  align-items:center;
  justify-content:space-between;
}

.c-handle{
  font-family:var(--mono);
  font-size:12px;
  color:var(--ink-soft);
  margin-top:2px;
}

@media (max-width:860px){
  .contact-grid{ grid-template-columns:1fr 1fr; }
}
@media (max-width:520px){
  .contact-grid{ grid-template-columns:1fr; }
}

/* ============================================
   FOOTER
   ============================================ */
footer{
  border-top:1px solid var(--line);
  padding:32px 0 48px;
}

footer .wrap{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16px;
  flex-wrap:wrap;
}

.f-copy{
  font-family:var(--mono);
  font-size:11.5px;
  color:var(--ink-faint);
}

.f-status{
  font-family:var(--mono);
  font-size:11.5px;
  color:var(--ink-faint);
  display:flex;
  align-items:center;
  gap:8px;
}

/* ============================================
   MOTION
   ============================================ */
.reveal{
  opacity:0;
  transform:translateY(16px);
  transition:opacity .6s ease, transform .6s ease;
}
.reveal.visible{ opacity:1; transform:none; }

@media (prefers-reduced-motion:reduce){
  html{ scroll-behavior:auto; }
  .reveal{ opacity:1; transform:none; transition:none; }
}

@media (max-width:640px){
  .wrap{ padding-left:22px; padding-right:22px; }
  section{ padding:56px 0; }
  .section-note{ display:none; }
}
</style>
</head>

