<script>
/* reveal-on-scroll */
const io = new IntersectionObserver((entries) => {
  entries.forEach((e, i) => {
    if (e.isIntersecting) {
      setTimeout(() => e.target.classList.add('visible'), i * 60);
      io.unobserve(e.target);
    }
  });
}, { threshold: 0.1 });

document.querySelectorAll('.reveal').forEach(el => io.observe(el));

/* ---- App detail data ---- */
const APP_DATA = {
  yalla: {
    title: 'Yalla Arabi',
    img: 'assets/yalla_final.jpg',
    status: 'live',
    platform: 'Shared platform · Build A',
    stat: 'Arabic-language tutor',
    desc: 'Learning-management app built for an Arabic-language tutor, on a Flutter front end with a Laravel backend shared across the platform-A build.',
    features: ['QR-code attendance', 'Real-time grades & results', 'Subscription tracking', 'Push notifications'],
    store: 'https://play.google.com/store/apps/details?id=com.platform.yallaarabi'
  },
  hawy: {
    title: 'Hawy El-Oloom',
    img: 'assets/elhawy_final.jpg',
    status: 'live',
    platform: 'Shared platform · Build A',
    stat: 'Science & biology tutor',
    desc: 'The same platform as Yalla Arabi, rebuilt and rebranded for a science and biology tutor — one backend, two independent clients.',
    features: ['Lessons library', 'Timed online exams', 'Instant exam results', 'Attendance & subscriptions'],
    store: 'https://play.google.com/store/apps/details?id=com.platform.elhawy'
  },
  cs1: {
    title: 'MN – CS1',
    img: 'assets/mncs_final.jpg',
    status: 'live',
    platform: 'Standalone build',
    stat: '500+ downloads',
    desc: 'Companion app for first-year Computer Science students at Minia University, built with Flutter to organize course resources in one place.',
    features: ['Course resource library', 'Simple, focused navigation', 'Built for first-year syllabus', 'Lightweight & offline-friendly'],
    store: 'https://play.google.com/store/apps/details?id=com.mnu_app_year1.learntrain'
  },
  cs2: {
    title: 'MN – CS2',
    img: 'assets/mncs_final.jpg',
    status: 'live',
    platform: 'Standalone build',
    stat: '100+ downloads',
    desc: 'Second-year continuation of the CS1 app, carrying the same interface forward with course material for the next year of the syllabus.',
    features: ['Course resource library', 'Consistent with CS1 UX', 'Built for second-year syllabus', 'Lightweight & offline-friendly'],
    store: 'https://play.google.com/store/apps/details?id=com.mnu_app_year2.learntrain'
  }
};

/* ---- Variant switch: reads data-variant + data-target off each button,
   updates the matching card's image/name/store-link, toggles .active.
   This listener was entirely absent before — the buttons rendered but did nothing. ---- */
document.querySelectorAll('.variant-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const target = btn.dataset.target;   // "lms" or "mn"
    const variant = btn.dataset.variant; // "yalla" | "hawy" | "cs1" | "cs2"
    const data = APP_DATA[variant];
    if (!data) return;

    btn.closest('.variant-switch').querySelectorAll('.variant-btn').forEach(b => {
      b.classList.toggle('active', b === btn);
      b.setAttribute('aria-selected', b === btn ? 'true' : 'false');
    });

    const img = document.getElementById(target + 'Img');
    const name = document.getElementById(target + 'Name');
    const storeLink = document.getElementById(target + 'StoreLink');

    if (img) {
      img.style.opacity = '0';
      setTimeout(() => { img.src = data.img; img.alt = data.title + ' app icon'; img.style.opacity = '1'; }, 120);
    }
    if (name) {
      name.style.opacity = '0';
      setTimeout(() => { name.textContent = data.title; name.style.opacity = '1'; }, 120);
    }
    if (storeLink) storeLink.href = data.store;
  });
});

const overlay = document.getElementById('detailOverlay');
const detailImg = document.getElementById('detailImg');
const detailTitle = document.getElementById('detailTitle');
const detailBadges = document.getElementById('detailBadges');
const detailDesc = document.getElementById('detailDesc');
const detailFeatures = document.getElementById('detailFeatures');
const detailPlatform = document.getElementById('detailPlatform');
const detailStat = document.getElementById('detailStat');
const detailStoreLink = document.getElementById('detailStoreLink');

let lastFocused = null;

function openDetail(key){
  const app = APP_DATA[key];
  if (!app) return;

  detailImg.src = app.img;
  detailImg.alt = app.title + ' app icon';
  detailTitle.textContent = app.title;

  detailBadges.innerHTML = '';
  const statusBadge = document.createElement('span');
  statusBadge.className = 'detail-badge b-live';
  statusBadge.textContent = 'Live on Play Store';
  detailBadges.appendChild(statusBadge);

  detailDesc.textContent = app.desc;

  detailFeatures.innerHTML = '';
  app.features.forEach(f => {
    const el = document.createElement('div');
    el.className = 'detail-feature';
    el.textContent = f;
    detailFeatures.appendChild(el);
  });

  detailPlatform.textContent = app.platform;
  detailStat.textContent = app.stat;
  detailStoreLink.href = app.store;

  lastFocused = document.activeElement;
  overlay.classList.add('open');
  overlay.setAttribute('aria-hidden', 'false');
  document.body.classList.add('modal-open');
  document.getElementById('detailClose').focus();
}

function closeDetail(){
  overlay.classList.remove('open');
  overlay.setAttribute('aria-hidden', 'true');
  document.body.classList.remove('modal-open');
  if (lastFocused) lastFocused.focus();
}

function activeVariantKeyFor(card){
  const activeBtn = card.querySelector('.variant-btn.active');
  if (activeBtn) return activeBtn.dataset.variant;
  return card.dataset.platform === 'lms' ? 'yalla' : 'cs1';
}

document.querySelectorAll('.platform-card').forEach(card => {
  card.addEventListener('click', (e) => {
    /* let the variant switch and the store link handle their own clicks */
    if (e.target.closest('.variant-switch') || e.target.closest('.platform-store-btn')) return;
    openDetail(activeVariantKeyFor(card));
  });
  card.addEventListener('keydown', (e) => {
    if (e.target !== card) return;
    if (e.key === 'Enter' || e.key === ' '){
      e.preventDefault();
      openDetail(activeVariantKeyFor(card));
    }
  });
});

const detailCloseBtnEl = document.getElementById('detailClose');
const detailCloseBtnFooter = document.getElementById('detailCloseBtn');
if (detailCloseBtnEl) detailCloseBtnEl.addEventListener('click', closeDetail);
if (detailCloseBtnFooter) detailCloseBtnFooter.addEventListener('click', closeDetail);

if (overlay) {
  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) closeDetail();
  });
}

document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape' && overlay && overlay.classList.contains('open')) closeDetail();
});
</script>

</body>
</html>
