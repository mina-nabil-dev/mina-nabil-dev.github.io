  cs2:{ platform:"إصدار مستقل", stat:"دفعة السنة الثانية",
    desc:"امتداد السنة الثانية لتطبيق CS1، بنفس الواجهة ومحتوى العام التالي من المنهج.",
    features:["مكتبة مصادر المقرر","متسق مع تجربة CS1","مبني لمنهج السنة الثانية","خفيف ويعمل دون إنترنت"] }
};

(function () {
  const root  = document.documentElement;
  const btn   = document.getElementById('langToggle');
  const nodes = [...document.querySelectorAll('[data-i18n]')];

  // snapshot the English exactly as authored, so switching back is lossless
  nodes.forEach(n => n.dataset.en = n.innerHTML);

  function apply(lang) {
    const ar = lang === 'ar';
    nodes.forEach(n => {
      const t = AR[n.dataset.i18n];
      n.innerHTML = ar && t ? t : n.dataset.en;
    });
    root.lang = ar ? 'ar' : 'en';
    root.dir  = ar ? 'rtl' : 'ltr';
    btn.textContent = ar ? 'English' : 'العربية';
    btn.setAttribute('aria-label', ar ? 'Switch to English' : 'التبديل إلى العربية');
    // the modal reads from a different source, so refresh it if it is open
    if (typeof window.refreshDetail === 'function') window.refreshDetail();
    try { localStorage.setItem('lang', lang); } catch (e) {}
  }

  window.currentLang = () => root.lang === 'ar' ? 'ar' : 'en';
  window.appsAR = APPS_AR;

  let saved = null;
  try { saved = localStorage.getItem('lang'); } catch (e) {}
  if (saved === 'ar') apply('ar');

  btn.addEventListener('click', () => apply(root.lang === 'ar' ? 'en' : 'ar'));
})();
</script>

</body>
</html>
