<style>
/* ============================================
   TOKENS
   Paper: warm off-white surface, ink-navy text.
   Accent: a single signal-blue, used sparingly —
   the color of a status light on hardware, not a
   gradient. Grounded in "build artifact" language:
   blueprint grid, build log, module manifest.
   ============================================ */
:root{
  --paper:      #f6f4ef;
  --paper-dim:  #efece3;
  --ink:        #171712;
  --ink-soft:   #57584f;
  --ink-faint:  #6a6b61;
  --surface:    #fdfbf7;   /* card surface — warm white, not pure #fff */
  --line:       #dcd8cb;
  --line-strong:#8e8878;   /* interactive borders, WCAG 1.4.11 needs >=3:1 */
  --line-soft:  #e8e5d9;
  --signal:     #2545e8;
  --signal-dim: #e6e9fc;
  --live:       #1c7a4d;
  --live-bg:    #e4f2ea;
  --test:       #8a5f10;
  --test-bg:    #f6ecd8;

  --display: 'Fraunces', serif;
  --body:    'Inter', sans-serif;
  --mono:    'IBM Plex Mono', monospace;

  --wrap: 1120px;
}

*,*::before,*::after{ box-sizing:border-box; margin:0; padding:0; }

html{ scroll-behavior:smooth; }

body{
  background:var(--paper);
  color:var(--ink);
  font-family:var(--body);
  font-size:16px;
  line-height:1.5;
  -webkit-font-smoothing:antialiased;
}

body.modal-open{ overflow:hidden; }

/* faint blueprint grid, fixed, very low contrast */
body::before{
  content:'';
  position:fixed;
  inset:0;
  z-index:0;
  pointer-events:none;
  background-image:
    linear-gradient(var(--line-soft) 1px, transparent 1px),
    linear-gradient(90deg, var(--line-soft) 1px, transparent 1px);
  background-size: 64px 64px;
  opacity:.5;
  mask-image: linear-gradient(to bottom, black, transparent 85%);
}

a{ color:inherit; }

img{ max-width:100%; display:block; }

.wrap{
  max-width:var(--wrap);
  margin:0 auto;
  padding-left:56px;
  padding-right:56px;
  position:relative;
  z-index:1;
}

::selection{ background:var(--signal); color:#fff; }

:focus-visible{
  outline:2px solid var(--signal);
  outline-offset:3px;
}

/* ============================================
   NAV
   ============================================ */
header{
  position:sticky;
  top:0;
  z-index:50;
  background:rgba(246,244,239,.88);
  backdrop-filter:blur(10px);
  border-bottom:1px solid var(--line);
}

nav.wrap{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding-top:20px;
  padding-bottom:20px;
}

.brand{
  font-family:var(--mono);
  font-size:14px;
  font-weight:500;
  letter-spacing:.02em;
}

.brand span{ color:var(--signal); }

.nav-links{
  display:flex;
  align-items:center;
  gap:36px;
}

.nav-links a{
  font-family:var(--mono);
  font-size:13px;
  text-decoration:none;
  color:var(--ink-soft);
  letter-spacing:.02em;
  transition:color .15s;
}

.nav-links a:hover{ color:var(--ink); }

.avail{
  display:flex;
  align-items:center;
  gap:8px;
  font-family:var(--mono);
  font-size:12px;
  color:var(--ink-soft);
  padding:6px 14px;
  border:1px solid var(--line);
  border-radius:100px;
  white-space:nowrap;
}

.avail-dot{
  width:6px; height:6px;
  border-radius:50%;
  background:var(--live);
  flex-shrink:0;
}

@media (max-width:860px){
  .nav-links{ display:none; }
}

/* ============================================
   HERO
   ============================================ */
.hero{
  padding-top:96px;
  padding-bottom:88px;
  display:grid;
  grid-template-columns:1.35fr 1fr;
  gap:64px;
  align-items:end;
}

.eyebrow{
  font-family:var(--mono);
  font-size:12px;
  color:var(--signal);
  letter-spacing:.06em;
  display:flex;
  align-items:center;
  gap:12px;
  margin-bottom:28px;
}

.eyebrow::before{
  content:'';
  width:28px; height:1px;
  background:var(--signal);
}

h1.name{
  font-family:var(--display);
  font-weight:600;
  font-size:clamp(44px,6.4vw,84px);
  line-height:.98;
  letter-spacing:-.01em;
  margin-bottom:26px;
}

h1.name em{
  font-style:italic;
  font-weight:380;
  color:var(--signal);
}

.hero-lede{
  font-size:18px;
  color:var(--ink-soft);
  max-width:52ch;
  line-height:1.6;
  margin-bottom:36px;
}

.hero-lede strong{ color:var(--ink); font-weight:600; }

.hero-cta{
  display:flex;
  gap:14px;
  flex-wrap:wrap;
}

.btn{
  font-family:var(--mono);
  font-size:13px;
  letter-spacing:.02em;
  padding:13px 24px;
  border-radius:4px;
  text-decoration:none;
  display:inline-flex;
  align-items:center;
  gap:8px;
  transition:transform .15s, background .15s, border-color .15s;
  border:none;
  cursor:pointer;
}

.btn-solid{
  background:var(--ink);
  color:var(--paper);
  border:1px solid var(--ink);
}
.btn-solid:hover{ background:var(--signal); border-color:var(--signal); transform:translateY(-2px); }

.btn-line{
  background:transparent;
  color:var(--ink);
  border:1px solid var(--line-strong);
}
.btn-line:hover{ border-color:var(--ink); transform:translateY(-2px); }

/* hero side: a manifest, not a stat-brag */
.manifest{
  border:1px solid var(--line);
  border-radius:8px;
  background:var(--surface);
  overflow:hidden;
}

.manifest-head{
  font-family:var(--mono);
  font-size:11px;
  color:var(--ink-faint);
  letter-spacing:.06em;
  padding:14px 20px;
  border-bottom:1px solid var(--line);
  background:var(--paper-dim);
}

.manifest-row{
  display:flex;
  justify-content:space-between;
  gap:16px;
  padding:16px 20px;
  border-bottom:1px solid var(--line-soft);
  font-family:var(--mono);
  font-size:13px;
}

.manifest-row:last-child{ border-bottom:none; }

.manifest-k{ color:var(--ink-faint); }
.manifest-v{ color:var(--ink); text-align:right; }

@media (max-width:860px){
  .hero{ grid-template-columns:1fr; padding-top:56px; padding-bottom:56px; gap:40px; }
}

/* ============================================
   SECTION SCAFFOLD
   ============================================ */
section{ padding:76px 0; }

.section-head{
  display:flex;
  align-items:baseline;
  justify-content:space-between;
  gap:24px;
  margin-bottom:44px;
  flex-wrap:wrap;
}

.tag{
  font-family:var(--mono);
  font-size:12px;
  color:var(--signal);
  letter-spacing:.06em;
  display:flex;
  align-items:center;
  gap:10px;
}

.tag::before{ content:'§'; color:var(--ink-faint); }

h2.stitle{
  font-family:var(--display);
  font-weight:600;
  font-size:clamp(28px,3.6vw,44px);
  letter-spacing:-.01em;
  line-height:1.05;
}

h2.stitle em{ font-style:italic; font-weight:380; color:var(--signal); }

.section-note{
  font-family:var(--mono);
  font-size:12px;
  color:var(--ink-faint);
  text-align:right;
}

hr.rule{
  border:none;
  border-top:1px solid var(--line);
  margin:0 0 76px;
}

/* ============================================
   ABOUT
   ============================================ */
.about-grid{
  display:grid;
  grid-template-columns:0.9fr 1.1fr;
  gap:64px;
}

.about-copy{
  font-size:17px;
  color:var(--ink-soft);
  line-height:1.75;
  max-width:60ch;
}

.about-copy p{ margin-bottom:18px; }
.about-copy p:last-child{ margin-bottom:0; }
.about-copy strong{ color:var(--ink); font-weight:600; }

.credentials{
  display:flex;
  flex-direction:column;
  gap:0;
  border-top:1px solid var(--line);
}

.cred-row{
  display:flex;
  justify-content:space-between;
  gap:20px;
  padding:18px 0;
  border-bottom:1px solid var(--line);
}

.cred-k{
  font-family:var(--mono);
  font-size:11px;
  color:var(--ink-faint);
  letter-spacing:.06em;
  text-transform:uppercase;
  padding-top:2px;
  flex-shrink:0;
  width:120px;
}

.cred-v{
  font-size:15px;
  color:var(--ink);
  text-align:right;
}

.cred-v span{
  display:block;
  font-size:13px;
  color:var(--ink-soft);
  margin-top:2px;
}

@media (max-width:860px){
  .about-grid{ grid-template-columns:1fr; gap:40px; }
}

/* ============================================
   STACK — grouped by role, not a flat grid.
   ============================================ */
.stack-groups{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:1px;
  background:var(--line);
  border:1px solid var(--line);
  border-radius:8px;
  overflow:hidden;
}

.stack-group{
  background:var(--surface);
  padding:28px 26px;
}

.stack-group-title{
  font-family:var(--mono);
  font-size:11px;
  color:var(--signal);
  letter-spacing:.06em;
  text-transform:uppercase;
  margin-bottom:18px;
  padding-bottom:14px;
  border-bottom:1px solid var(--line-soft);
}

.stack-item{
  display:flex;
  justify-content:space-between;
  align-items:baseline;
  gap:12px;
  padding:9px 0;
  font-size:14.5px;
}

.stack-item + .stack-item{ border-top:1px solid var(--line-soft); }

.stack-item-name{ color:var(--ink); font-weight:500; }
.stack-item-note{
  font-family:var(--mono);
  font-size:11.5px;
  color:var(--ink-faint);
  text-align:right;
  white-space:nowrap;
}

@media (max-width:860px){
  .stack-groups{ grid-template-columns:1fr; }
}

/* ============================================
   PUBLISHED WORK — one platform, two deployments
   ============================================ */
.platform-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:22px;
}

.platform-card{
  background:var(--surface);
  border:1px solid var(--line);
  border-radius:14px;
  overflow:hidden;
  display:flex;
  flex-direction:column;
  transition:border-color .18s, box-shadow .18s;
  cursor:pointer;
}

.platform-card:hover{
  border-color:var(--ink);
  box-shadow:0 14px 32px -18px rgba(23,23,18,.28);
}

.platform-top{
  display:flex;
  gap:16px;
  padding:22px 24px 18px;
  border-bottom:1px solid var(--line-soft);
}

.platform-media{
  width:64px; height:64px;
  border-radius:10px;
  overflow:hidden;
  flex-shrink:0;
  border:1px solid var(--line);
  background:var(--paper-dim);
  position:relative;
}

.platform-media img{
  width:100%; height:100%;
  object-fit:cover;
  transition:opacity .18s ease;
}

.platform-heading{ flex:1; min-width:0; padding-top:2px; }

.platform-label{
  font-family:var(--mono);
  font-size:10.5px;
  letter-spacing:.06em;
  text-transform:uppercase;
  color:var(--signal);
  margin-bottom:4px;
}

.platform-name{
  font-family:var(--display);
  font-weight:600;
  font-size:19px;
  letter-spacing:-.005em;
  transition:opacity .12s ease;
}

.platform-status{
  display:inline-flex;
  align-items:center;
  gap:5px;
  font-family:var(--mono);
  font-size:10px;
  letter-spacing:.04em;
  text-transform:uppercase;
  color:var(--live);
  margin-top:5px;
}

.platform-status::before{ content:''; width:5px; height:5px; border-radius:50%; background:var(--live); }

.platform-body{
  padding:18px 24px 22px;
  flex:1;
  display:flex;
  flex-direction:column;
}

.platform-desc{
  font-size:13.5px;
  color:var(--ink-soft);
  line-height:1.65;
  margin-bottom:16px;
}

.platform-desc strong{ color:var(--ink); font-weight:600; }

.platform-features{
  display:flex;
  flex-wrap:wrap;
  gap:7px;
  margin-bottom:20px;
}

.platform-feature{
  font-family:var(--mono);
  font-size:10.5px;
  color:var(--ink-soft);
  background:var(--paper-dim);
  border:1px solid var(--line-soft);
  padding:4px 10px;
  border-radius:100px;
}

/* variant switch: the ONE thing that actually differs */
.variant-row{
  margin-top:auto;
}

.variant-label{
  font-family:var(--mono);
  font-size:10px;
  letter-spacing:.06em;
  text-transform:uppercase;
  color:var(--ink-faint);
  margin-bottom:8px;
}

.variant-switch{
  display:flex;
  border:1px solid var(--line);
  border-radius:8px;
  overflow:hidden;
  margin-bottom:14px;
}

.variant-btn{
  flex:1;
  background:var(--surface);
  border:none;
  font-family:var(--mono);
  font-size:12px;
  letter-spacing:.02em;
  color:var(--ink-soft);
  padding:10px 8px;
  cursor:pointer;
  transition:background .15s, color .15s;
  position:relative;
}

.variant-btn + .variant-btn{ border-left:1px solid var(--line); }

.variant-btn:hover{ background:var(--paper-dim); }

.variant-btn.active{
  background:var(--ink);
  color:var(--paper);
}

.variant-actions{
  display:flex;
  gap:10px;
}

.platform-store-btn{
  flex:1;
  font-family:var(--mono);
  font-size:12px;
  letter-spacing:.02em;
  color:#fff;
  background:var(--ink);
  border:1px solid var(--ink);
  border-radius:6px;
  padding:11px 14px;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:6px;
  text-decoration:none;
  transition:background .15s, border-color .15s, transform .15s;
}

.platform-store-btn:hover{ background:var(--signal); border-color:var(--signal); transform:translateY(-2px); }

.platform-shared-note{
  grid-column:1 / -1;
  font-family:var(--mono);
  font-size:11.5px;
  color:var(--ink-faint);
  display:flex;
  align-items:center;
  gap:10px;
  margin-top:2px;
}

.platform-shared-note::before{
  content:'';
  width:20px; height:1px;
  background:var(--line);
  flex-shrink:0;
}

.apps-lead{
  font-size:14.5px;
  color:var(--ink-soft);
  max-width:64ch;
  line-height:1.65;
}

.apps-lead strong{ color:var(--ink); font-weight:600; }

@media (max-width:760px){
  .platform-grid{ grid-template-columns:1fr; }
}

/* ---- Detail modal ---- */
.detail-overlay{
  position:fixed;
  inset:0;
  z-index:100;
  background:rgba(23,23,18,.46);
  backdrop-filter:blur(3px);
  display:flex;
  align-items:center;
  justify-content:center;
  padding:24px;
  opacity:0;
  pointer-events:none;
  transition:opacity .22s ease;
}

.detail-overlay.open{
  opacity:1;
  pointer-events:auto;
}

.detail-panel{
  position:relative;
  background:var(--paper);
  border:1px solid var(--line);
  border-radius:14px;
  max-width:640px;
  width:100%;
  max-height:88vh;
  overflow-y:auto;
  transform:translateY(18px) scale(.98);
  transition:transform .24s cubic-bezier(.2,.8,.2,1);
  box-shadow:0 30px 60px -20px rgba(23,23,18,.35);
}

.detail-overlay.open .detail-panel{ transform:translateY(0) scale(1); }

.detail-top{
  display:flex;
  gap:20px;
  padding:28px 28px 20px;
  border-bottom:1px solid var(--line);
}

.detail-media{
  width:96px; height:96px;
  border-radius:12px;
  overflow:hidden;
  border:1px solid var(--line);
  flex-shrink:0;
  background:var(--paper-dim);
}

.detail-media img{ width:100%; height:100%; object-fit:cover; }

.detail-heading{ flex:1; min-width:0; }

.detail-title{
  font-family:var(--display);
  font-weight:600;
  font-size:26px;
  letter-spacing:-.01em;
  margin-bottom:8px;
}

.detail-badges{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
}

.detail-badge{
  font-family:var(--mono);
  font-size:10.5px;
  letter-spacing:.04em;
  text-transform:uppercase;
  padding:4px 10px;
  border-radius:100px;
  background:var(--paper-dim);
  color:var(--ink-soft);
  border:1px solid var(--line);
}

.detail-badge.b-live{ background:var(--live-bg); color:var(--live); border-color:rgba(28,122,77,.25); }

.detail-close{
  position:absolute;
  top:18px; right:18px;
  width:32px; height:32px;
  border-radius:50%;
  border:1px solid var(--line);
  background:var(--surface);
  color:var(--ink-soft);
  font-size:16px;
  line-height:1;
  display:flex;
  align-items:center;
  justify-content:center;
  cursor:pointer;
  transition:border-color .15s, color .15s, transform .15s;
}

.detail-close:hover{ border-color:var(--ink); color:var(--ink); transform:rotate(90deg); }

.detail-body{
  padding:24px 28px 28px;
}

.detail-desc{
  font-size:15px;
  color:var(--ink-soft);
  line-height:1.7;
  margin-bottom:22px;
}

.detail-features{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
  margin-bottom:26px;
}

.detail-feature{
  font-size:13.5px;
  color:var(--ink);
  padding:11px 14px;
  background:var(--surface);
  border:1px solid var(--line);
  border-radius:8px;
  display:flex;
  align-items:baseline;
  gap:8px;
}

.detail-feature::before{
  content:'—';
  color:var(--signal);
  flex-shrink:0;
}

.detail-meta-row{
  display:flex;
  justify-content:space-between;
  align-items:center;
  font-family:var(--mono);
  font-size:12px;
  color:var(--ink-faint);
  padding:14px 0;
  border-top:1px solid var(--line-soft);
  margin-bottom:22px;
}

.detail-actions{
  display:flex;
  gap:12px;
  flex-wrap:wrap;
}

@media (max-width:560px){
  .detail-top{ flex-direction:column; align-items:flex-start; padding:24px 20px 18px; }
  .detail-body{ padding:20px 20px 24px; }
  .detail-features{ grid-template-columns:1fr; }
  .detail-close{ top:14px; right:14px; }
}

/* ============================================
   OPEN SOURCE — dense manifest list
   ============================================ */
.oss-list{
  border:1px solid var(--line);
  border-radius:8px;
  overflow:hidden;
  background:var(--surface);
}

.oss-row{
  display:flex;
  align-items:center;
  gap:22px;
  padding:20px 28px;
  text-decoration:none;
  border-bottom:1px solid var(--line-soft);
  transition:background .15s;
}

.oss-row:last-child{ border-bottom:none; }
.oss-row:hover{ background:var(--paper-dim); }

.oss-idx{
  font-family:var(--mono);
  font-size:11px;
  color:var(--ink-faint);
  width:22px;
  flex-shrink:0;
}

.oss-main{ flex:1; min-width:0; }

.oss-name{
  font-size:15px;
  font-weight:600;
  color:var(--ink);
}

.oss-desc{
  font-size:13px;
  color:var(--ink-soft);
  margin-top:2px;
}

.oss-tags{
  display:flex;
  gap:8px;
  flex-shrink:0;
}

.oss-tag{
  font-family:var(--mono);
  font-size:10.5px;
  color:var(--signal);
  background:var(--signal-dim);
  padding:3px 10px;
  border-radius:100px;
  white-space:nowrap;
}

.oss-arr{
  color:var(--ink-faint);
  font-size:15px;
  flex-shrink:0;
  transition:color .15s, transform .15s;
}

.oss-row:hover .oss-arr{ color:var(--signal); transform:translate(2px,-2px); }

@media (max-width:640px){
  .oss-row{ flex-wrap:wrap; padding:18px 20px; }
  .oss-tags{ width:100%; padding-left:44px; }
}

/* ============================================
   CONTACT
   ============================================ */
.contact-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr); /* 6 cards -> two full rows, no empty cells */
  gap:1px;
  background:var(--line);
  border:1px solid var(--line);
  border-radius:8px;
  overflow:hidden;
}

.c-card{
  background:var(--surface);
  padding:28px 22px;
  text-decoration:none;
  display:flex;
  flex-direction:column;
  gap:16px;
  transition:background .15s;
}

.c-card:hover{ background:var(--paper-dim); }

.c-ico{
  width:38px;height:38px;
  border-radius:8px;
  display:flex;align-items:center;justify-content:center;
  font-size:17px;
  border:1px solid var(--line);
  background:var(--paper-dim);
}

.c-name{
  font-size:14.5px;
  font-weight:600;
  color:var(--ink);
  display:flex;
  align-items:center;
  justify-content:space-between;
}

.c-handle{
  font-family:var(--mono);
  font-size:12px;
  color:var(--ink-soft);
  margin-top:2px;
}

@media (max-width:860px){
  .contact-grid{ grid-template-columns:1fr 1fr; }
}
@media (max-width:520px){
  .contact-grid{ grid-template-columns:1fr; }
}

/* ============================================
   FOOTER
   ============================================ */
footer{
  border-top:1px solid var(--line);
  padding:32px 0 48px;
}

footer .wrap{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16px;
  flex-wrap:wrap;
}

.f-copy{
  font-family:var(--mono);
  font-size:11.5px;
  color:var(--ink-faint);
}

.f-status{
  font-family:var(--mono);
  font-size:11.5px;
  color:var(--ink-faint);
  display:flex;
  align-items:center;
  gap:8px;
}

/* ============================================
   MOTION
   ============================================ */
.reveal{
  opacity:0;
  transform:translateY(16px);
  transition:opacity .6s ease, transform .6s ease;
}
.reveal.visible{ opacity:1; transform:none; }

@media (prefers-reduced-motion:reduce){
  html{ scroll-behavior:auto; }
  .reveal{ opacity:1; transform:none; transition:none; }
}

@media (max-width:640px){
  .wrap{ padding-left:22px; padding-right:22px; }
  section{ padding:56px 0; }
  .section-note{ display:none; }
}

/* ---- app screenshot strips ---- */
.shot-strip{
  display:flex; gap:12px; margin:22px 0 2px;
  overflow-x:auto; overscroll-behavior-x:contain;
  padding:2px 2px 8px; scrollbar-width:thin;
  scrollbar-color:var(--line2, #dcd8cb) transparent;
}
.shot-strip::-webkit-scrollbar{ height:6px; }
.shot-strip::-webkit-scrollbar-thumb{ background:#dcd8cb; border-radius:3px; }
.shot{
  flex:1 1 0; min-width:0; margin:0; padding:4px;
  background:#0b0b10; border-radius:15px;
  box-shadow:0 3px 12px rgba(23,23,18,.10);
}
.shot img{ display:block; width:100%; height:auto; border-radius:11px; }
.shot-note{
  font-family:var(--mono); font-size:11.5px; color:var(--ink-faint);
  margin:2px 0 0; letter-spacing:.02em;
}
@media (max-width:560px){
  /* below this width a fluid third is too small to read — swipe through them instead */
  .shot-strip{ scroll-snap-type:x mandatory; }
  .shot{ flex:0 0 132px; scroll-snap-align:start; padding:3px; border-radius:12px; }
  .shot img{ border-radius:9px; }
}

/* ============ Arabic / RTL ============ */
:root{ --arabic: 'IBM Plex Sans Arabic', 'Segoe UI', Tahoma, sans-serif; }

html[lang="ar"] body,
html[lang="ar"] .stitle,
html[lang="ar"] .name,
html[lang="ar"] .hero-lede,
html[lang="ar"] .platform-desc,
html[lang="ar"] .about-copy p{ font-family:var(--arabic); }
html[lang="ar"] .stitle em,
html[lang="ar"] .name em{ font-style:normal; }
/* keep the monospace character for the manifest widget, latin-only content stays mono */
html[lang="ar"] .manifest-k,
html[lang="ar"] .manifest-v,
html[lang="ar"] .tag,
html[lang="ar"] .section-note,
html[lang="ar"] .cred-k,
html[lang="ar"] .shot-note,
html[lang="ar"] .platform-shared-note{ font-family:var(--arabic); letter-spacing:0; }

/* physical properties that must flip */
[dir="rtl"] .manifest-v,
[dir="rtl"] .section-note,
[dir="rtl"] .cred-v,
[dir="rtl"] .stack-item-note{ text-align:left; }
[dir="rtl"] .variant-btn + .variant-btn{ border-left:0; border-right:1px solid var(--line); }
[dir="rtl"] .detail-close{ right:auto; left:18px; }
[dir="rtl"] .oss-tags{ padding-left:0; padding-right:44px; }
[dir="rtl"] .hero-lede,
[dir="rtl"] .apps-lead,
[dir="rtl"] .about-copy p{ text-align:right; }
/* arrows point the other way when the text does */
[dir="rtl"] .oss-arr{ transform:scaleX(-1); display:inline-block; }

/* latin runs inside arabic text keep their own direction */
html[lang="ar"] .c-handle,
html[lang="ar"] .f-copy{ direction:ltr; unicode-bidi:isolate; }
[dir="rtl"] .c-handle,
[dir="rtl"] .f-copy{ text-align:right; }

/* ---- language toggle ---- */
.lang-toggle{
  font-family:var(--mono); font-size:12px; letter-spacing:.04em;
  padding:7px 13px; border-radius:999px; cursor:pointer;
  background:var(--surface); color:var(--ink-soft);
  border:1px solid var(--line-strong);
  transition:background .18s ease, color .18s ease;
}
.lang-toggle:hover{ background:var(--signal); border-color:var(--signal); color:#fff; }
.lang-toggle:focus-visible{ outline:2px solid var(--signal); outline-offset:2px; }
html[lang="ar"] .lang-toggle{ font-family:var(--mono); }
@media (max-width:860px){ .avail{ display:none; } }
</style>
</head>

<body>

<header>
  <nav class="wrap" aria-label="Main navigation">
    <span class="brand">mina<span>.</span>dev</span>

    <div class="nav-links">
      <a data-i18n="nav_1" href="#work">Work</a>
      <a data-i18n="nav_2" href="#about">About</a>
      <a data-i18n="nav_3" href="#stack">Stack</a>
      <a data-i18n="nav_4" href="#oss">Projects</a>
      <a data-i18n="nav_5" href="#contact">Contact</a>
    </div>

    <button class="lang-toggle" id="langToggle" type="button" aria-label="Switch language">العربية</button>

    <div class="avail" aria-label="Availability status" data-i18n="avail_1">
      <span class="avail-dot" ></span>
      Available for freelance
    </div>
  </nav>
</header>

<main>

<!-- HERO -->
<section class="hero wrap" aria-label="Introduction">
  <div>
    <p class="eyebrow reveal" data-i18n="eyebrow_1">Flutter Developer · Minya, Egypt · Open to Remote</p>

    <h1 class="name reveal">Mina<br><em>Nabil</em></h1>

    <p class="hero-lede reveal" data-i18n="hero_lede_1">
      I build <strong>cross-platform mobile apps</strong> with Flutter — from the interface
      down to the backend that runs it. My work spans <strong>Firebase</strong>,
      <strong>Supabase</strong>, and custom <strong>Laravel APIs</strong>, structured with
      <strong>Clean Architecture</strong> and <strong>BLoC/Cubit</strong> so apps stay easy to
      extend once they're live.
    </p>

    <div class="hero-cta reveal">
      <a href="#work" class="btn btn-solid" data-i18n="btn_solid_1">View my work ↓</a>
      <a href="https://github.com/mina-nabil-dev" target="_blank" rel="noopener" class="btn btn-line" data-i18n="btn_line_1">GitHub ↗</a>
      <a href="https://linkedin.com/in/mina-nabil-97bb1b300" target="_blank" rel="noopener" class="btn btn-line" data-i18n="btn_line_2">LinkedIn ↗</a>
    </div>
  </div>

  <div class="manifest reveal" aria-label="Developer summary">
    <div class="manifest-head">manifest.json</div>
    <div class="manifest-row"><span class="manifest-k" data-i18n="manifest_k_1">role</span><span class="manifest-v" data-i18n="manifest_v_1">Flutter Developer</span></div>
    <div class="manifest-row"><span class="manifest-k" data-i18n="manifest_k_2">focus</span><span class="manifest-v" data-i18n="manifest_v_2">Android · iOS</span></div>
    <div class="manifest-row"><span class="manifest-k" data-i18n="manifest_k_3">apps_live</span><span class="manifest-v" data-i18n="manifest_v_3">4 on Play Store</span></div>
    <div class="manifest-row"><span class="manifest-k" data-i18n="manifest_k_4">architecture</span><span class="manifest-v" data-i18n="manifest_v_4">Clean · BLoC/Cubit</span></div>
  </div>
</section>

<!-- ABOUT -->

<section id="work">
  <div class="wrap">
    <div class="section-head reveal">
      <div class="tag" data-i18n="tag_1">Published work</div>
      <div class="section-note" data-i18n="section_note_1">2 platforms · 4 live deployments</div>
    </div>

    <h2 class="stitle reveal" style="margin-bottom:16px;" data-i18n="stitle_1">
      Build once, <em>ship for two</em>
    </h2>

    <p class="apps-lead reveal" style="margin-bottom:36px;" data-i18n="apps_lead_1">
      Each card below is one platform I built — the architecture, features, and backend are
      written once. The switch inside picks which live deployment of it you're looking at.
    </p>

    <div class="platform-grid">

      <!-- PLATFORM 1: Tutor LMS (Yalla Arabi / Hawy El-Oloom) -->
      <div class="platform-card reveal" data-platform="lms" tabindex="0" role="button" aria-label="View Yalla Arabi / Hawy El-Oloom details">
        <div class="platform-top">
          <div class="platform-media">
            <img id="lmsImg" src="assets/yalla_final.jpg" alt="Yalla Arabi app icon" loading="lazy" />
          </div>
          <div class="platform-heading">
            <div class="platform-label" data-i18n="platform_label_1">Tutor LMS platform</div>
            <div class="platform-name" id="lmsName">Yalla Arabi</div>
            <span class="platform-status" data-i18n="platform_status_1">Live</span>
          </div>
        </div>

        <div class="platform-body">
          <p class="platform-desc" data-i18n="platform_desc_1">
            A white-label learning-management app for private tutors, on <strong>Flutter</strong>
            with a shared <strong>Laravel</strong> backend. Built once, then re-branded and deployed
            for two independent tutors teaching different subjects.
          </p>

          <div class="platform-features">
            <span class="platform-feature" data-i18n="platform_feature_1">QR-code attendance</span>
            <span class="platform-feature" data-i18n="platform_feature_2">Timed online exams</span>
            <span class="platform-feature" data-i18n="platform_feature_3">Real-time results</span>
            <span class="platform-feature" data-i18n="platform_feature_4">Subscription tracking</span>
          </div>

          <div class="shot-strip" role="group" aria-label="Yalla Arabi screenshots">
            <figure class="shot"><img src="assets/shots/yalla-home.webp" width="640" height="1304" loading="lazy" decoding="async" alt="Yalla Arabi home screen with the tutor profile and the active monthly course" /></figure>
            <figure class="shot"><img src="assets/shots/yalla-courses.webp" width="640" height="1304" loading="lazy" decoding="async" alt="Course catalogue listing available monthly subscriptions with start and end dates" /></figure>
            <figure class="shot"><img src="assets/shots/yalla-lesson.webp" width="640" height="1306" loading="lazy" decoding="async" alt="Lesson list showing completion progress and the exams attached to each lesson" /></figure>
          </div>
          <p class="shot-note" data-i18n="shot_note_1">From the live listing</p>

          <div class="variant-row">
            <div class="variant-label" data-i18n="variant_label_1">Deployed as</div>
            <div class="variant-switch" role="tablist" aria-label="Choose deployment">
              <button class="variant-btn active" role="tab" aria-selected="true" data-variant="yalla" data-target="lms">Yalla Arabi</button>
              <button class="variant-btn" role="tab" aria-selected="false" data-variant="hawy" data-target="lms">Hawy El-Oloom</button>
            </div>
            <div class="variant-actions">
              <a href="https://play.google.com/store/apps/details?id=com.platform.yallaarabi" target="_blank" rel="noopener" class="platform-store-btn" id="lmsStoreLink" aria-label="Open on Google Play" data-i18n="platform_store_btn_1">Open on Google Play ↗</a>
            </div>
          </div>
        </div>
      </div>

      <!-- PLATFORM 2: MN Learning (CS1 / CS2) -->
      <div class="platform-card reveal" data-platform="mn" tabindex="0" role="button" aria-label="View MN Learning details">
        <div class="platform-top">
          <div class="platform-media">
            <img id="mnImg" src="assets/mncs_final.jpg" alt="MN Learning app icon" loading="lazy" />
          </div>
          <div class="platform-heading">
            <div class="platform-label" data-i18n="platform_label_2">MN Learning platform</div>
            <div class="platform-name" id="mnName">MN – CS1</div>
            <span class="platform-status" data-i18n="platform_status_2">Live</span>
          </div>
        </div>

        <div class="platform-body">
          <p class="platform-desc" data-i18n="platform_desc_2">
            A course-companion app for Computer Science students at <strong>Minia University</strong>,
            built with Flutter. One codebase, reused each year with that year's course material.
          </p>

          <div class="platform-features">
            <span class="platform-feature" data-i18n="platform_feature_5">Course resource library</span>
            <span class="platform-feature" data-i18n="platform_feature_6">Simple, focused navigation</span>
            <span class="platform-feature" data-i18n="platform_feature_7">Offline-friendly</span>
          </div>

          <div class="shot-strip" role="group" aria-label="MN CS1 screenshots">
            <figure class="shot"><img src="assets/shots/mncs-subjects.webp" width="640" height="1137" loading="lazy" decoding="async" alt="Semester subject list with colour-coded cards for each course" /></figure>
            <figure class="shot"><img src="assets/shots/mncs-resources.webp" width="640" height="1387" loading="lazy" decoding="async" alt="Resource types for a course: theory videos, image gallery and PDF files" /></figure>
            <figure class="shot"><img src="assets/shots/mncs-quiz.webp" width="640" height="1137" loading="lazy" decoding="async" alt="Multiple-choice quiz screen showing an answered question and the final score" /></figure>
          </div>
          <p class="shot-note" data-i18n="shot_note_2">From the live listing</p>

          <div class="variant-row">
            <div class="variant-label" data-i18n="variant_label_2">Deployed as</div>
            <div class="variant-switch" role="tablist" aria-label="Choose deployment">
              <button class="variant-btn active" role="tab" aria-selected="true" data-variant="cs1" data-target="mn">CS · Year 1</button>
              <button class="variant-btn" role="tab" aria-selected="false" data-variant="cs2" data-target="mn">CS · Year 2</button>
            </div>
            <div class="variant-actions">
              <a href="https://play.google.com/store/apps/details?id=com.mnu_app_year1.learntrain" target="_blank" rel="noopener" class="platform-store-btn" id="mnStoreLink" aria-label="Open on Google Play" data-i18n="platform_store_btn_2">Open on Google Play ↗</a>
            </div>
          </div>
        </div>
      </div>

      <p class="platform-shared-note reveal" data-i18n="platform_shared_note_1">4 listings live on Google Play · 600+ downloads · built from these 2 codebases</p>
    </div>
  </div>
</section>

<section id="about">
  <div class="wrap">
    <div class="section-head reveal">
      <div class="tag" data-i18n="tag_2">About</div>
    </div>

    <h2 class="stitle reveal" style="margin-bottom:44px;" data-i18n="stitle_2">
      Idea to <em>Play Store</em>, one system at a time
    </h2>

    <div class="about-grid">
      <div class="about-copy reveal">
        <p data-i18n="about_p1">
          I'm a Flutter developer from Minya, Egypt. I build cross-platform mobile
          applications end to end — interface, state, backend, and deployment.
        </p>
        <p data-i18n="about_p2">
          Most of what I build is made to be re-used. The tutoring platform above runs as
          <strong>four Play Store listings from two codebases</strong> — taking on a new tutor is a
          rebrand and a config change, not a rewrite.
        </p>
      </div>

      <div class="credentials reveal">
        <div class="cred-row">
          <div class="cred-k" data-i18n="cred_k_1">Location</div>
          <div class="cred-v" data-i18n="cred_v_1">Minya, Egypt<span>Remote-friendly</span></div>
        </div>
        <div class="cred-row">
          <div class="cred-k" data-i18n="cred_k_2">Education</div>
          <div class="cred-v" data-i18n="cred_v_2">Computer Science<span>Minia University</span></div>
        </div>
        <div class="cred-row">
          <div class="cred-k" data-i18n="cred_k_3">Deployment</div>
          <div class="cred-v" data-i18n="cred_v_3">Google Play Store<span>Full publishing pipeline</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- STACK -->
<section id="stack">
  <div class="wrap">
    <div class="section-head reveal">
      <div class="tag" data-i18n="tag_3">Stack</div>
    </div>

    <h2 class="stitle reveal" style="margin-bottom:44px;" data-i18n="stitle_3">
      Tools organized by <em>what they do</em>
    </h2>

    <div class="stack-groups reveal">
      <div class="stack-group">
        <div class="stack-group-title" data-i18n="stack_group_title_1">Application</div>
        <div class="stack-item"><span class="stack-item-name">Flutter</span><span class="stack-item-note" data-i18n="stack_item_note_1">Primary framework</span></div>
        <div class="stack-item"><span class="stack-item-name">Dart</span><span class="stack-item-note" data-i18n="stack_item_note_2">Application logic</span></div>
        <div class="stack-item"><span class="stack-item-name">BLoC / Cubit</span><span class="stack-item-note" data-i18n="stack_item_note_3">State management</span></div>
        <div class="stack-item"><span class="stack-item-name">Clean Architecture</span><span class="stack-item-note" data-i18n="stack_item_note_4">App structure</span></div>
      </div>

      <div class="stack-group">
        <div class="stack-group-title" data-i18n="stack_group_title_2">Backend &amp; Data</div>
        <div class="stack-item"><span class="stack-item-name">Firebase</span><span class="stack-item-note" data-i18n="stack_item_note_5">Auth · Firestore</span></div>
        <div class="stack-item"><span class="stack-item-name">Supabase</span><span class="stack-item-note" data-i18n="stack_item_note_6">Database · Storage</span></div>
        <div class="stack-item"><span class="stack-item-name">Laravel</span><span class="stack-item-note" data-i18n="stack_item_note_7">PHP backend</span></div>
        <div class="stack-item"><span class="stack-item-name">MySQL</span><span class="stack-item-note" data-i18n="stack_item_note_8">Database design</span></div>
        <div class="stack-item"><span class="stack-item-name">REST APIs</span><span class="stack-item-note" data-i18n="stack_item_note_9">Integration</span></div>
      </div>

      <div class="stack-group">
        <div class="stack-group-title" data-i18n="stack_group_title_3">Delivery &amp; Security</div>
        <div class="stack-item"><span class="stack-item-name">JWT Auth</span><span class="stack-item-note" data-i18n="stack_item_note_10">Access control</span></div>
        <div class="stack-item"><span class="stack-item-name">Encryption</span><span class="stack-item-note" data-i18n="stack_item_note_11">Sensitive data</span></div>
        <div class="stack-item"><span class="stack-item-name">Play Store</span><span class="stack-item-note" data-i18n="stack_item_note_12">Publishing</span></div>
