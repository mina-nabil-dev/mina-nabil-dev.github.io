};

/* Arabic copy for the project modal (mirrors the APP_DATA object above). */
const APPS_AR = {
  yalla:{ platform:"المنصة المشتركة · الإصدار A", stat:"مدرّس لغة عربية",
    desc:"منصة إدارة تعلّم كاملة لمدرّس لغة عربية — الدروس والحضور والامتحانات والاشتراكات في تطبيق واحد.",
